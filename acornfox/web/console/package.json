{
  "name": "acornfox-console",
  "private": true,
  "version": "0.5.0",
  "description": "AcornFox 网页控制台（新版）。构建产物写到 ../../internal/console/ui，由 Go 嵌入。",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
