{
  "schema": 1,
  "serial": 4,
  "apps": [],
  "recipes": [],
  "service_types": [
    {
      "schema": 1,
      "kind": "llm_gateway",
      "label": "大模型接口",
      "summary": "兼容 OpenAI 接口的大模型服务，给要调用大模型的应用用",
      "fields": [
        {
          "key": "base_url",
          "label": "接口地址",
          "type": "url",
          "required": true
        },
        {
          "key": "api_key",
          "label": "API Key",
          "type": "string",
          "required": true,
          "secret": true
        },
        {
          "key": "model",
          "label": "默认模型",
          "type": "string"
        }
      ],
      "test": {
        "http": {
          "url": "{{base_url}}/models",
          "bearer": "{{api_key}}",
          "expect_status": [
            200
          ]
        }
      }
    },
    {
      "schema": 1,
      "kind": "mysql",
      "label": "MySQL 数据库",
      "summary": "一个 MySQL 库和能用它的账号，给要存数据的应用用",
      "fields": [
        {
          "key": "host",
          "label": "地址",
          "type": "string",
          "required": true,
          "hint": "数据库服务器的主机名或 IP，不带端口"
        },
        {
          "key": "port",
          "label": "端口",
          "type": "int",
          "default": 3306
        },
        {
          "key": "database",
          "label": "库名",
          "type": "string",
          "required": true
        },
        {
          "key": "username",
          "label": "账号",
          "type": "string",
          "required": true
        },
        {
          "key": "password",
          "label": "密码",
          "type": "string",
          "required": true,
          "secret": true
        },
        {
          "key": "url",
          "label": "连接串",
          "type": "string",
          "secret": true,
          "hint": "形如 mysql://账号:密码@地址:端口/库名，可以不填"
        }
      ],
      "test": {
        "tcp": {
          "host": "{{host}}",
          "port": "{{port}}"
        }
      }
    },
    {
      "schema": 1,
      "kind": "postgres",
      "label": "PostgreSQL 数据库",
      "summary": "一个 PostgreSQL 库和能用它的账号，给要存数据的应用用",
      "fields": [
        {
          "key": "host",
          "label": "地址",
          "type": "string",
          "required": true,
          "hint": "数据库服务器的主机名或 IP，不带端口"
        },
        {
          "key": "port",
          "label": "端口",
          "type": "int",
          "default": 5432
        },
        {
          "key": "database",
          "label": "库名",
          "type": "string",
          "required": true
        },
        {
          "key": "username",
          "label": "账号",
          "type": "string",
          "required": true
        },
        {
          "key": "password",
          "label": "密码",
          "type": "string",
          "required": true,
          "secret": true
        },
        {
          "key": "sslmode",
          "label": "加密连接",
          "type": "enum",
          "default": "disable",
          "options": [
            "disable",
            "require",
            "verify-full"
          ],
          "hint": "同一台机器上的数据库选 disable；连外面的云数据库一般选 require"
        },
        {
          "key": "url",
          "label": "连接串",
          "type": "string",
          "secret": true,
          "hint": "形如 postgres://账号:密码@地址:端口/库名，可以不填"
        }
      ],
      "test": {
        "tcp": {
          "host": "{{host}}",
          "port": "{{port}}"
        }
      }
    },
    {
      "schema": 1,
      "kind": "redis",
      "label": "Redis 缓存",
      "summary": "一个 Redis，给要用缓存或消息队列的应用用",
      "fields": [
        {
          "key": "host",
          "label": "地址",
          "type": "string",
          "required": true,
          "hint": "Redis 服务器的主机名或 IP，不带端口"
        },
        {
          "key": "port",
          "label": "端口",
          "type": "int",
          "default": 6379
        },
        {
          "key": "username",
          "label": "账号",
          "type": "string",
          "hint": "没开账号功能的 Redis 填 default 或留空"
        },
        {
          "key": "password",
          "label": "密码",
          "type": "string",
          "secret": true,
          "hint": "没设密码就留空"
        },
        {
          "key": "url",
          "label": "连接串",
          "type": "string",
          "secret": true,
          "hint": "形如 redis://default:密码@地址:端口，可以不填"
        }
      ],
      "test": {
        "tcp": {
          "host": "{{host}}",
          "port": "{{port}}"
        }
      }
    },
    {
      "schema": 1,
      "kind": "smtp",
      "label": "邮箱（发信）",
      "summary": "给应用发通知邮件用的发信服务器",
      "fields": [
        {
          "key": "host",
          "label": "服务器地址",
          "type": "string",
          "required": true
        },
        {
          "key": "port",
          "label": "端口",
          "type": "int",
          "default": 587
        },
        {
          "key": "username",
          "label": "账号",
          "type": "string"
        },
        {
          "key": "password",
          "label": "密码",
          "type": "string",
          "secret": true
        },
        {
          "key": "from",
          "label": "发件人地址",
          "type": "string"
        },
        {
          "key": "tls",
          "label": "加密方式",
          "type": "enum",
          "default": "starttls",
          "options": [
            "starttls",
            "tls",
            "none"
          ]
        }
      ],
      "test": {
        "tcp": {
          "host": "{{host}}",
          "port": "{{port}}"
        }
      }
    }
  ]
}
