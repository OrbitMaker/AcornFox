{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acornfox.com/catalog/schema/recipe-1.json",
  "title": "AcornFox 配方 schema 1",
  "description": "recipes/<id>/recipe.yaml：把一个或几个应用按固定搭配装好，并连起来。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema", "title", "summary", "apps", "delivery"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
    "schema": { "const": 1 },
    "title": { "type": "string", "minLength": 2, "maxLength": 30 },
    "summary": { "type": "string", "minLength": 4, "maxLength": 80 },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "apps": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "description": "按顺序安装；本机已装的同名应用会直接复用，不重复装",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["app"],
        "properties": {
          "app": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
          "reuse_installed": { "type": "boolean", "default": true },
          "preset": { "type": "object", "description": "预填的参数（键是该应用的 params.key）" }
        }
      }
    },
    "links": {
      "type": "array",
      "description": "把 apps 里的应用连起来：to 的 uses 由 from 的 provides 满足",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "uses"],
        "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "uses": { "type": "string" } }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier"],
      "properties": {
        "tier": { "enum": ["auto", "steps"] },
        "minutes": { "type": "integer", "minimum": 1 },
        "memory_mb": { "type": "integer", "minimum": 64 },
        "video": { "type": "string", "format": "uri" },
        "user_steps": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
