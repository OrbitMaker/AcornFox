{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acornfox.com/catalog/schema/recipe-1.json",
  "title": "AcornFox 配方 schema 1",
  "description": "recipes/<id>/recipe.yaml：把一个或几个应用按固定搭配装好，并连起来。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema", "title", "summary", "apps", "delivery"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
    "schema": { "const": 1 },
    "min_platform": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "description": "最低平台版本。可以不写：打包时按配方用到的写法和成员应用的最低版本自动算。写了就不能比算出来的低（catalog lint 报 CAT-LINT-17）" },
    "title": { "type": "string", "minLength": 2, "maxLength": 30 },
    "summary": { "type": "string", "minLength": 4, "maxLength": 80 },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "apps": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "description": "按顺序安装；本机已装的同名应用会直接复用，不重复装",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["app"],
        "properties": {
          "app": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
          "reuse_installed": { "type": "boolean", "default": true },
          "preset": { "type": "object", "description": "预填的参数（键是该应用的 params.key）" }
        }
      }
    },
    "links": {
      "type": "array",
      "description": "把 apps 里的应用连起来：to 这个应用名叫 uses 的那项需要，接 from 这个应用提供的同类型服务。from 要排在 to 前面（按 apps 的顺序装，后装的接先装的）。没写连接的需要按平台的匹配规则接",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "uses"],
        "properties": {
          "from": { "type": "string", "description": "提供服务的应用（apps 里的 app），要提供 to 那项需要的服务类型" },
          "to": { "type": "string", "description": "需要服务的应用（apps 里的 app）" },
          "uses": { "type": "string", "description": "to 的清单里 uses[].name，不是服务类型名" }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier"],
      "properties": {
        "tier": { "enum": ["auto", "steps"] },
        "minutes": { "type": "integer", "minimum": 1 },
        "memory_mb": { "type": "integer", "minimum": 64 },
        "video": { "type": "string", "format": "uri" },
        "user_steps": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
