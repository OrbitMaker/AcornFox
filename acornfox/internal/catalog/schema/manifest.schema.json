{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acornfox.com/catalog/schema/manifest-3.json",
  "title": "AcornFox 应用清单 schema 3",
  "description": "apps/<id>/manifest.yaml 的格式。单机版和云版共用。这里只放程序要读的字段；上架状态、排序、文案等运营数据不在清单里。第 3 版从 AcornFox 0.6.0 起才认，更早的版本不装第 3 版的清单；这一版的平台也不装第 2 版及更早的清单。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema", "source", "app", "lifecycle", "resources", "release", "endpoints"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$", "description": "和目录名相同" },
    "schema": { "const": 3 },
    "source": { "enum": ["upstream", "community", "official"] },
    "maintainer": { "type": "string" },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "category", "license", "homepage"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "summary": { "type": "string", "minLength": 4, "maxLength": 80 },
        "category": { "enum": ["ai", "ai-agent", "ai-gateway", "automation", "site", "database", "monitor", "dev", "files"] },
        "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
        "keywords": { "type": "array", "items": { "type": "string" }, "description": "搜索时也能命中的词，例如中文俗称" },
        "icon": { "type": "string", "pattern": "^[a-z0-9._-]+\\.(svg|png)$" },
        "homepage": { "type": "string", "format": "uri" },
        "license": { "type": "string", "description": "SPDX 表达式" },
        "source_code": { "type": "string", "format": "uri", "description": "GPL、AGPL 类许可证必填" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_platform", "status"],
      "properties": {
        "min_platform": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": { "enum": ["active", "deprecated"] }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_mb", "platforms"],
      "properties": {
        "memory_mb": { "$ref": "#/$defs/minRec" },
        "cpu": { "type": "object", "additionalProperties": false, "properties": { "min": { "type": "number", "exclusiveMinimum": 0 } } },
        "disk_mb": { "type": "object", "additionalProperties": false, "properties": { "min": { "type": "integer", "minimum": 0 } } },
        "platforms": { "type": "array", "minItems": 1, "items": { "enum": ["linux/amd64", "linux/arm64"] } },
        "gpu": { "enum": ["none", "optional", "required"] }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "images"],
      "properties": {
        "version": { "type": "string", "not": { "const": "latest" } },
        "images": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "description": "首发只支持单容器；多容器在后续版本放开",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "repository", "digest"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "repository": { "type": "string", "pattern": "^[a-z0-9]+([._/-][a-z0-9]+)*$", "description": "不带仓库前缀，前缀由下载来源决定" },
              "tag": { "type": "string", "not": { "const": "latest" } },
              "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "size_mb": { "type": "integer", "minimum": 1 },
              "artifact": { "type": "string", "description": "镜像文件在下载网关上的文件编号（大镜像经网关下发时填）" },
              "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "网关上那个镜像包（docker save 出来的 tar）的 SHA256；下载后先按它核对再导入，不填就不走网关" },
              "artifact_size": { "type": "integer", "minimum": 1, "description": "那个镜像包的字节数" },
              "artifacts": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "description": "按 CPU 架构分开的镜像包。键是架构名，只能写 amd64、arm64（和 resources.platforms 里 linux/ 后面那段相同，不写 x86_64、aarch64）；值是那种架构的镜像包。写了它就不再写 artifact、artifact_sha256、artifact_size（那种旧写法只算 amd64 的）。哪种架构没有包，那种架构的机器就从公共源按 digest 拉；私有目录的应用在那种机器上装不了",
                "properties": {
                  "amd64": { "$ref": "#/$defs/archArtifact" },
                  "arm64": { "$ref": "#/$defs/archArtifact" }
                }
              }
            }
          }
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": { "type": "array", "items": { "type": "string" }, "description": "启动命令，参数数组，不经过命令行解释：每一项是一个模板（可以写 {{params.*}}、{{platform.*}} 等引用和变换），渲染成一个参数；不能引用保密的值" },
        "user": { "type": "string" },
        "shm_mb": { "type": "integer", "minimum": 64 },
        "pids_limit": { "type": "integer", "minimum": 64 },
        "no_new_privileges": { "type": "boolean", "default": true }
      }
    },
    "endpoints": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "port", "protocol"],
        "properties": {
          "name": { "type": "string" },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "protocol": { "enum": ["http", "tcp"], "description": "http：说 HTTP 的入口（网页、接口）；tcp：不说 HTTP 的入口（数据库、缓存这类），只给别的应用经内部网络连，入口代理不转发它" },
          "primary": { "type": "boolean" },
          "health": {
            "type": "object",
            "additionalProperties": false,
            "description": "怎么判断应用好了，三选一：path（向这个入口发 GET，只用于 http 入口）；exec（在应用自己的容器里执行这条命令，退出码 0 算好了）；tcp: true（这个入口的端口连得上算好了）",
            "properties": {
              "path": { "type": "string", "pattern": "^/", "description": "只用于 protocol: http 的入口" },
              "expect_json": { "type": "object", "description": "只和 path 一起用：应答 JSON 要包含这些字段和值" },
              "exec": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "参数数组，原样执行，不经过命令行解释，不是模板；一个元素是一个参数，不能有换行。不要放保密值：要用的密码从容器自己的环境变量读" },
              "expect_stdout": { "type": "string", "minLength": 1, "description": "只和 exec 一起用：写了它，命令的标准输出去掉首尾空白后还要等于它才算好了（有的服务没准备好时检查命令的退出码也是 0）。原样比较，不是模板，首尾不能有空白" },
              "tcp": { "const": true, "description": "只看这个入口的端口连不连得上" },
              "timeout_s": { "type": "integer", "minimum": 5, "maximum": 1200 }
            },
            "oneOf": [{ "required": ["path"] }, { "required": ["exec"] }, { "required": ["tcp"] }],
            "dependentRequired": { "expect_json": ["path"], "expect_stdout": ["exec"] }
          }
        }
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "default": { "enum": ["local", "lan", "public", "internal"], "description": "local：只本机能打开；lan：局域网；public：公网；internal：只在内部网络，不映射宿主机端口、不建入口路由、页面和命令行不给“打开”，别的应用按它的实例名和容器内端口连它" } }
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "path": { "type": "string", "pattern": "^/" },
          "backup": { "type": "boolean" }
        }
      }
    },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "type"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": { "enum": ["string", "int", "bool", "enum", "secret", "url", "domain", "email"] },
          "label": { "type": "string" },
          "hint": { "type": "string" },
          "default": {},
          "options": { "type": "array" },
          "pattern": { "type": "string" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "required": { "type": "boolean" },
          "hidden": { "type": "boolean", "description": "不出现在表单里，只由平台生成" },
          "generate": { "$ref": "#/$defs/generate" },
          "editable": { "enum": ["never", "always", "reinstall"] },
          "scope": { "enum": ["all", "standalone", "cloud"] }
        }
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "from": { "type": "string", "pattern": "^(params|platform|uses)\\.[a-z0-9_.]+$", "description": "params.<名> 是这个清单自己的设置项；platform.<名字> 是平台变量，名字只能用程序里那张表上的（acornfox catalog platform-vars）；uses.<名>.<项> 是接上的那条服务的一项，项名是那种服务类型定义里的 fields[].key" },
          "value": { "type": "string", "description": "模板：固定的文字，或者带引用和变换的文字，例如 \"{{platform.app.url}}/\"、\"{{uses.db.sslmode | map \\\"disable=false\\\" \\\"*=true\\\"}}\"。原样写进环境变量，不转义" },
          "secret": { "type": "boolean" },
          "optional": { "type": "boolean", "description": "from 或 value 里引用的东西没有值时（例如一个可选的 uses 没接上），或 value 渲染出来是空的，这一条环境变量整条不写。不写它而又取不到值，安装前就报错" },
          "if": { "type": "string", "minLength": 1, "description": "条件，成立时才写这一条：'引用'（有值且不是 false、0、空）、'引用 == 值'、'引用 != 值'，引用不带 {{ }}，例如 'platform.region == cn'。同名的环境变量可以写几条，每条都要写 if，而且不能同时成立" }
        },
        "oneOf": [{ "required": ["from"] }, { "required": ["value"] }]
      }
    },
    "files": {
      "type": "array",
      "description": "安装时写进数据卷的配置文件（模板里写 {{params.*}} 等引用和变换，别的 {{…}} 原样保留，\\{{ 写出字面的 {{；yaml、json 文件里填进的值转义引号和反斜杠），不在宿主机执行任何脚本",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["volume", "path", "template"],
        "properties": {
          "volume": { "type": "string" },
          "path": { "type": "string", "pattern": "^[a-zA-Z0-9._/-]+$" },
          "template": { "type": "string" },
          "mode": { "type": "string", "pattern": "^0[0-7]{3}$" },
          "owner": { "type": "string", "pattern": "^[0-9]{1,6}:[0-9]{1,6}$", "description": "文件属主 uid:gid，应用不以 root 运行时填它的用户" },
          "overwrite": { "enum": ["never", "install"] },
          "if": { "type": "string", "minLength": 1, "description": "条件，成立时才写这个文件，写法和 env 的 if 一样" }
        }
      }
    },
    "init": {
      "type": "array",
      "description": "健康检查通过后替用户做的初始化步骤。一组步骤共用一个会话（同一个 Cookie 罐，save 下来的值后面的步骤都能用），按顺序执行，一步不过就停",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["when"],
        "properties": {
          "name": { "type": "string", "description": "可选，出错时用来说是哪一步" },
          "when": { "enum": ["after_healthy"] },
          "http": { "$ref": "#/$defs/stepHTTP" },
          "exec": { "$ref": "#/$defs/stepExec" }
        },
        "oneOf": [{ "required": ["http"] }, { "required": ["exec"] }]
      }
    },
    "first_login": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label"],
        "properties": { "label": { "type": "string" }, "from": { "type": "string" }, "value": { "type": "string", "description": "模板：固定的文字，或者带引用和变换的文字（没写 from 时用它）" }, "secret": { "type": "boolean" } }
      }
    },
    "provides": {
      "type": "array",
      "description": "这个应用装好以后能给别的应用用的服务。values 写每一项值怎么来，issue、revoke、purge、check 写要平台代做的步骤，ready 写怎么判断这条服务现在能不能真用",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 40, "description": "服务类型的名字，由目录里的服务类型定义（service-types/<kind>.yaml）来认" },
          "endpoint": { "type": "string", "description": "这个应用的哪个入口；写了它，values 和 revoke、purge、check、ready 的步骤里才能用 self.*（self.host 是这个应用在内部网络里的名字，self.port 是这个入口的端口）" },
          "max_consumers": { "type": "integer", "minimum": 1, "description": "这条服务同时最多接几个使用方，至少 1；不写是不限。只能给一个使用方用的服务（例如一个使用方一个实例的缓存）写 1" },
          "values": {
            "type": "object",
            "description": "项名 → 值的来法。项名是那种服务类型定义里的 fields[].key",
            "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
            "additionalProperties": { "$ref": "#/$defs/valueSource" }
          },
          "issue_vars": {
            "type": "object",
            "minProperties": 1,
            "description": "每次发凭据前由平台先定好的值：键是名字，值是模板（能引用 issue.id、consumer.name、consumer.id、params.<名>、platform.<名>）或 { generate: { length, charset }, secret: true }（平台用安全随机数生成，一律按保密处理）。issue 的步骤里写 {{issue.<键>}}；发成功后和 save 下来的值一样存进凭据，values、revoke、check 里写 issued.<键>。键名不能是 id、issue_id，也不能和 issue 步骤 save 的键重名",
            "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
            "additionalProperties": { "$ref": "#/$defs/issueVar" }
          },
          "issue": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" }, "description": "给一个使用方发凭据时照着做。save 下来的值和 issue_vars 里，values 里用到的（{ issued: 键 } 或模板里的 issued.<键>）和 revoke、purge、check 里用 issued.<键> 引用到的（外加平台自己存的 issue_id）就是发给它的凭据，其余用完就丢" },
          "revoke": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" }, "description": "收回凭据时照着做：收回这个使用方的账号、让它连不上，不删数据。能用 issued.<键>，写了 endpoint 时还能用 self.*" },
          "purge": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" }, "description": "只在使用方连数据一起删时照着做（先照 revoke 收回，再照它删）：删掉给这个使用方建的数据，例如它的库。能用 issued.<键>，写了 endpoint 时还能用 self.*，能写 finish_if（要删的已经没了算成功）。只在写了 issue 的 provides 上有意义" },
          "check": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" }, "description": "接旧数据重装时判断旧凭据还能不能接着用，全部通过算能用，能用 issued.<键>，写了 endpoint 时还能用 self.*（要像使用方那样经内部网络连，例如连 {{self.host}}，不连 127.0.0.1）。不通过时怎么办看 on_check_fail" },
          "on_check_fail": { "enum": ["reissue", "stop"], "description": "接旧数据重装时 check 不通过怎么办：reissue（不写就是它）重新发一份；stop 停下、把情况告诉用户，不自动换（存数据的服务写它：换一份就等于悄悄接到一个空库上）。只在写了 issue 和 check 的 provides 上有意义" },
          "ready": {
            "type": "object",
            "additionalProperties": false,
            "required": ["steps", "say"],
            "description": "就绪检查：这条服务现在能不能真用（例如还没配好上游）。不通过不挡匹配，只在服务上标“还不能用”，并把 say 原样给用户看",
            "properties": {
              "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" }, "description": "只读的步骤（http 或 exec 都行），全部通过算就绪。没有使用方、不带发给使用方的凭据：能引用 params.<名>、platform.<名>、saved.<键>，这条 provides 写了 endpoint 时还有 self.internal_url、self.host、self.port；不能引用 issued、consumer、issue" },
              "say": { "type": "string", "minLength": 1, "maxLength": 120, "description": "没就绪时原样给用户看的一句话：缺什么、到哪里去补。不是模板，不能写 {{…}}" }
            }
          }
        }
      }
    },
    "uses": {
      "type": "array",
      "description": "这个应用需要的服务。安装时平台在本机登记的服务里找同类型的接上；引用时写 uses.<name>.<项>",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 40, "description": "服务类型的名字，由目录里的服务类型定义（service-types/<kind>.yaml）来认" },
          "optional": { "type": "boolean", "description": "不写或 false 表示必须有" },
          "without": { "type": "string", "minLength": 1, "maxLength": 80, "description": "没有这项服务时会怎样，给用户看的一句话；optional 为 true 时必填" },
          "dedicated": { "type": "boolean", "description": "匹配规则：只接没有别的使用方在用的服务，接上以后别的使用方不能再接。平台不替它另装实例：这台机器上没有这样的服务时，和“必须的服务没有”一样处理（可选的跳过；必须的停下，只提示登记一条）。要一起装好一个专用的，靠发布出来的配方" }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier"],
      "properties": {
        "tier": { "enum": ["auto", "steps"] },
        "minutes": { "type": "integer", "minimum": 1 },
        "video": { "type": "string", "format": "uri" },
        "user_steps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "upgrade": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "from": { "type": "string" }, "breaking": { "type": "boolean" }, "notes": { "type": "string" } }
    },
    "uninstall": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "data": { "type": "array", "items": { "type": "string", "pattern": "^volumes\\.[a-z0-9-]+$" } } }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "description": "一个步骤：http 或 exec 二选一",
      "properties": {
        "name": { "type": "string", "description": "可选，出错时用来说是哪一步" },
        "http": { "$ref": "#/$defs/stepHTTP" },
        "exec": { "$ref": "#/$defs/stepExec" }
      },
      "oneOf": [{ "required": ["http"] }, { "required": ["exec"] }]
    },
    "stepHTTP": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "description": "向这个应用自己的入口发一个请求。path、headers、json、expect_json、save 的 where 里的文字都是模板，能写 {{params.*}}、{{platform.*}}，以及只在步骤里有的 {{saved.<键>}}、{{issued.<键>}}、{{consumer.name}}、{{consumer.id}}。模板里每个 {{…}} 都当引用取值，取不到就算这一步失败",
      "properties": {
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "pattern": "^/", "description": "只写路径，主机固定是这个应用自己的入口" },
        "headers": { "type": "object", "propertyNames": { "pattern": "^[A-Za-z0-9-]+$" }, "additionalProperties": { "type": "string" } },
        "json": { "type": "object" },
        "expect_status": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 100, "maximum": 599 }, "description": "不写时 2xx 都算过" },
        "expect_json": { "type": "object", "description": "应答 JSON 要包含这些字段和值（子集匹配）。里面的文字可以写模板" },
        "save": {
          "type": "object",
          "minProperties": 1,
          "description": "把应答里的值存下来：键名 → 怎么取。后面的步骤用 {{saved.<键名>}} 引用",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/saveValue" }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["times", "delay_s"],
          "description": "只用在 GET 步骤上：判断不过或要存的值取不到时，等 delay_s 秒重发，最多 times 次。连接没建立时的重发不受它影响",
          "properties": {
            "times": { "type": "integer", "minimum": 1, "maximum": 10 },
            "delay_s": { "type": "integer", "minimum": 0, "maximum": 30 }
          }
        },
        "finish_if": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "description": "只用在 revoke、purge 步骤上：应答和它对上时，这一组步骤到此结束并算成功，后面的步骤不做（要收回或删掉的东西已经没了不算出错）。status 是状态码之一，json 是应答 JSON 要包含的字段和值（子集匹配，能写模板）；两样都写时都要对上",
          "properties": {
            "status": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 100, "maximum": 599 } },
            "json": { "type": "object", "minProperties": 1 }
          }
        }
      }
    },
    "saveValue": {
      "type": ["string", "object"],
      "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
      "additionalProperties": false,
      "description": "三种写法：一个字符串，是应答 JSON 里的点路径（data.access_token）；{ path, prefix, secret }；{ list, where, sort_by, pick, field, prefix, secret }，从列表里按条件挑一项",
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$", "description": "应答 JSON 里的点路径" },
        "prefix": { "type": "string", "description": "加在取到的值前面" },
        "secret": { "type": "boolean", "description": "保密：日志、进度、报错里一律遮住" },
        "list": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$", "description": "指向一个数组的点路径" },
        "where": { "type": "object", "description": "只留这些字段都相等的项" },
        "sort_by": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$", "description": "按这个字段升序排（数字按数值）" },
        "pick": { "enum": ["first", "last"], "description": "取第一项还是最后一项，不写是 last" },
        "field": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$", "description": "取挑中那一项的哪个字段" }
      },
      "oneOf": [
        { "type": "string" },
        { "type": "object", "required": ["path"], "not": { "anyOf": [{ "required": ["list"] }, { "required": ["where"] }, { "required": ["sort_by"] }, { "required": ["pick"] }, { "required": ["field"] }] } },
        { "type": "object", "required": ["list", "field"], "not": { "required": ["path"] } }
      ]
    },
    "stepExec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "description": "在这个应用自己的容器里执行一条命令。command、user、env 的值、stdin 都是模板，能写的引用和 http 步骤一样（issue 的步骤里另有 {{issue.<键>}}）。保密值只能经 env 和 stdin 传，不能写进 command、user（进程列表里看得到）。输出最多收 64 KiB，超了算失败；超时算失败，命令可能还在容器里跑",
      "properties": {
        "command": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "参数数组，不经过命令行解释：一个元素渲染成一个参数，不能有换行" },
        "user": { "type": "string", "minLength": 1, "description": "容器里用哪个用户执行，不写就是容器默认的用户" },
        "env": {
          "type": "object",
          "description": "只给这一条命令的环境变量：名字 → 值（模板，可以是保密值）",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": { "type": "string" }
        },
        "stdin": { "type": "string", "description": "从标准输入送给命令的内容（模板，可以带保密值）" },
        "timeout_s": { "type": "integer", "minimum": 1, "maximum": 300, "description": "不写是 30 秒" },
        "expect_exit": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "maximum": 255 }, "description": "算通过的退出码，不写是 [0]" },
        "save": {
          "type": "object",
          "minProperties": 1,
          "description": "把标准输出里的值存下来：键名 → 怎么取。后面的步骤用 {{saved.<键名>}} 引用",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/execSaveValue" }
        },
        "finish_if": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exit"],
          "description": "只用在 revoke、purge 步骤上：退出码是其中之一时，这一组步骤到此结束并算成功，后面的步骤不做（要收回或删掉的东西已经没了不算出错）",
          "properties": {
            "exit": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "maximum": 255 } }
          }
        }
      }
    },
    "execSaveValue": {
      "type": ["string", "object"],
      "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
      "additionalProperties": false,
      "description": "exec 步骤的 save，四种写法。前三种和 http 步骤的 save 一样，把标准输出当成 JSON 来取（点路径；{ path, prefix, secret }；{ list, where, sort_by, pick, field, prefix, secret }）；第四种 { stdout: true, prefix, secret } 取整段标准输出，去掉首尾空白",
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$", "description": "标准输出（JSON）里的点路径" },
        "prefix": { "type": "string", "description": "加在取到的值前面" },
        "secret": { "type": "boolean", "description": "保密：日志、进度、报错里一律遮住" },
        "list": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$", "description": "指向一个数组的点路径" },
        "where": { "type": "object", "description": "只留这些字段都相等的项" },
        "sort_by": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$", "description": "按这个字段升序排（数字按数值）" },
        "pick": { "enum": ["first", "last"], "description": "取第一项还是最后一项，不写是 last" },
        "field": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$", "description": "取挑中那一项的哪个字段" },
        "stdout": { "const": true, "description": "取整段标准输出（去掉首尾空白），不当 JSON 读" }
      },
      "oneOf": [
        { "type": "string" },
        { "type": "object", "required": ["path"], "not": { "anyOf": [{ "required": ["list"] }, { "required": ["where"] }, { "required": ["sort_by"] }, { "required": ["pick"] }, { "required": ["field"] }, { "required": ["stdout"] }] } },
        { "type": "object", "required": ["list", "field"], "not": { "anyOf": [{ "required": ["path"] }, { "required": ["stdout"] }] } },
        { "type": "object", "required": ["stdout"], "not": { "anyOf": [{ "required": ["path"] }, { "required": ["list"] }, { "required": ["where"] }, { "required": ["sort_by"] }, { "required": ["pick"] }, { "required": ["field"] }] } }
      ]
    },
    "issueVar": {
      "type": ["string", "object"],
      "minLength": 1,
      "additionalProperties": false,
      "description": "发凭据前先定好的一个值，两种写法：一个字符串（模板）；{ generate: { length, charset }, secret: true }，平台用安全随机数生成，一律按保密处理",
      "properties": {
        "generate": { "$ref": "#/$defs/generate" },
        "secret": { "const": true, "description": "生成的值一律按保密处理；写不写都一样，只能写 true" }
      },
      "oneOf": [
        { "type": "string" },
        { "type": "object", "required": ["generate"] }
      ]
    },
    "generate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length"],
      "description": "由平台用安全随机数生成：length 是长度，charset 是字符集（alnum：大小写字母和数字，不写就是它；hex：十六进制）",
      "properties": { "length": { "type": "integer", "minimum": 20, "maximum": 128 }, "charset": { "enum": ["alnum", "hex"] } }
    },
    "valueSource": {
      "type": ["string", "object"],
      "minLength": 1,
      "additionalProperties": false,
      "description": "值的来法，四选一：一个字符串（模板，平台直接算出来，能引用 self.internal_url、self.host、self.port、params.<名>、platform.<名>；这条 provides 写了 issue 时还能引用 issued.<键>，引用了就是给每个使用方单独发的项）；{ template: 模板, secret: true }，同一种模板，写成对象是为了标保密；{ issued: 键名 }，每个使用方单独发，值取自 issue 步骤 save 下来的或 issue_vars 里的那个键；{ ask: 一句话 }，要用户在应用里做一步、再填进来。模板引用了保密的值（保密的参数、平台变量、保密的 issued.<键>）时必须写成 { template: 模板, secret: true }（服务类型里这一项已标保密的除外），平台只按写明的保密标记处理这一项",
      "properties": {
        "template": { "type": "string", "minLength": 1 },
        "issued": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "ask": { "type": "string", "minLength": 1, "maxLength": 80 },
        "secret": { "type": "boolean" }
      },
      "oneOf": [
        { "type": "string" },
        { "type": "object", "required": ["template"], "not": { "anyOf": [{ "required": ["issued"] }, { "required": ["ask"] }] } },
        { "type": "object", "required": ["issued"], "not": { "anyOf": [{ "required": ["ask"] }, { "required": ["template"] }] } },
        { "type": "object", "required": ["ask"], "not": { "anyOf": [{ "required": ["issued"] }, { "required": ["template"] }] } }
      ]
    },
    "minRec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min"],
      "properties": { "min": { "type": "integer", "minimum": 64 }, "recommended": { "type": "integer", "minimum": 64 } }
    },
    "archArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "size"],
      "description": "一种架构的镜像包（docker save 出来的 tar，只含这一种架构的镜像），经下载网关下发",
      "properties": {
        "file": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$", "description": "镜像包在下载网关上的文件编号" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "镜像包的 SHA256；下载后先按它核对再导入" },
        "size": { "type": "integer", "minimum": 1, "description": "镜像包的字节数" }
      }
    }
  }
}
